# Frontend and backend are separate. Frontend only holds UI; all data lives in backend DB via REST + Socket.IO.

DATABASE_URL=postgresql://user:password@localhost:5432/fleettrack
# Used by Prisma for migrations (direct connection, no pooler). Same value works.
DIRECT_URL=postgresql://user:password@localhost:5432/fleettrack
JWT_SECRET=change-me-super-secret
# Public URL of the frontend (email links + CORS). Local: http://localhost:3100 (single-host) or :3000 (split).
APP_URL=http://localhost:3100
FRONTEND_URL=http://localhost:3100
PORT=4000

# Production (Render): behind a proxy + cross-site cookies for Vercel frontend.
TRUST_PROXY=0
CROSS_SITE_AUTH=false
# Single-host local server reads this; Render uses the split server (ignore).
SINGLE_PROD=1
# Password hashing cost. Keep 12 in production.
BCRYPT_ROUNDS=12

# Email (SMTP/Nodemailer). Leave blank to use stub logger in dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=FleetTrack <no-reply@fleettrack.example>

# Global mail catcher: when set, EVERY outgoing email is delivered here
# (subject/body note the original recipient). Leave empty for normal delivery.
EMAIL_REDIRECT_TO=

SIMULATION_ENABLED=true
SEED_ADMIN_EMAIL=admin@fleettrack.example
SEED_ADMIN_PASSWORD=Admin@12345
